{
  "name": "gblog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "prebuild": "node ./scripts/runAllGenerators.ts",
    "dev": "vite",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write src/ scripts/ vite/",
    "data:translate": "node ./scripts/tools/translator/translatorCli.ts",
    "data:tag-merge": "node ./scripts/tools/tagMerger/tagMergerCli.ts",
    "data:pack": "node ./scripts/tools/packArticle.ts",
    "data:deploy": "git -C ../blog-data add -A && git -C ../blog-data commit -m \"chore: update content\" && git -C ../blog-data push origin data",
    "data:publish": "git -C ../blog-data push origin data",
    "translate": "npm run data:translate",
    "tagmerge": "npm run data:tag-merge",
    "pack": "npm run data:pack",
    "deploy": "npm run data:deploy"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.4.0",
    "@popperjs/core": "^2.11.8",
    "@unhead/vue": "^2.1.16",
    "bootstrap": "^5.3.7",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "minisearch": "^7.2.0",
    "openai": "^5.20.1",
    "pinia": "^3.0.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-parse-frontmatter": "^1.0.3",
    "remark-rehype": "^11.1.2",
    "sass": "^1.90.0",
    "unified": "^11.0.5",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.24",
    "vue-i18n": "^12.0.0-alpha.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "globals": "^16.3.0",
    "jszip": "^3.10.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue-tsc": "^3.3.9"
  }
}
